# ── Supabase (required) ─────────────────────────────────────────────────────
# required — every page that talks to Supabase needs both of these. App will
# fail to load without them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# required — service-role client used by /api/ingest and /api/commands/*.
# If missing, those routes throw a clear "SUPABASE_SERVICE_ROLE_KEY is not set"
# error; agents will keep retrying with non-2xx warnings.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App URL (recommended) ───────────────────────────────────────────────────
# optional — used to template the ingest URL into agent install scripts.
# Falls back to the request origin when not set; recommended in production
# so agents always get the canonical hostname even behind proxies.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web Push (optional) ─────────────────────────────────────────────────────
# optional — generate with: npx web-push generate-vapid-keys
# If unset, the bell icon hides itself; pushes are simply not delivered.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
